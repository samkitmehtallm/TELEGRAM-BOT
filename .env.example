# Telegram — from BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Google AI Studio (used for scoring + keyword extraction, and for drafting during L3)
GEMINI_API_KEY=your_gemini_key_here

# Anthropic (used for drafting from B1 onward — holds voice better across a full post)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Which model writes the actual draft: "gemini" (default for this build) or "claude"
DRAFT_PROVIDER=gemini

# Below this score (0-10), the note is rejected and no draft is generated
SCORE_THRESHOLD=6

# Supabase — memory layer (B1 Checkpoint 3). Leave blank to run without persistence.
SUPABASE_URL=
SUPABASE_KEY=
