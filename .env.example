# Telegram — from BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Google AI Studio — used for scoring, keyword extraction, and drafting if DRAFT_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here

# Anthropic — used for drafting if DRAFT_PROVIDER=claude (optional, holds voice better across a full post)
ANTHROPIC_API_KEY=

# Which model writes the actual draft: "gemini" (default) or "claude"
DRAFT_PROVIDER=gemini

# Ordered model fallback chain. Google's flash backends hit 503 in rotating bursts, so a
# single model is a single point of failure — the first model that answers is used.
GEMINI_MODELS=gemini-flash-latest,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest

# How many candidate sources to pull per search query (3 queries are run per note)
SOURCES_PER_QUERY=3

# Supabase — memory layer (notes, drafts, sources). Leave blank to run without persistence.
SUPABASE_URL=
SUPABASE_KEY=
